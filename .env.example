# -----------------------------------------------------------------------------
# Luminary AI — environment variables
# Copy to apps/web/.env.local and apps/api/.env as needed.
# Never commit real secrets.
# -----------------------------------------------------------------------------

# Web (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (API / privileged jobs — never put these in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
API_URL=http://localhost:8000
INTERNAL_API_TOKEN=dev-internal-token

# Feature flags and cost controls
AI_PROVIDER=mock
ENABLE_VIDEO_RENDERING=false
ENABLE_AVATAR_GENERATION=false
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=50
MAX_PROJECTS_PER_USER=10
MAX_FILES_PER_PROJECT=25

# Optional browser mirrors for client-side validation (defaults match server)
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=500
NEXT_PUBLIC_MAX_DOCUMENT_UPLOAD_MB=50
NEXT_PUBLIC_MAX_FILES_PER_PROJECT=25
