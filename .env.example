# -----------------------------------------------------------------------------
# Luminary AI — environment variables
# Local:
#   cp .env.example apps/web/.env.local
#   cp .env.example apps/api/.env
# Production: set the same keys in Vercel (web) and Fly/Render/Railway (API).
# Never commit real secrets. See docs/deployment.md.
# -----------------------------------------------------------------------------

# Web (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (Next.js server actions / privileged jobs — never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
API_URL=http://localhost:8000
INTERNAL_API_TOKEN=replace-with-long-random-secret

# API-only
# Comma-separated browser origins for CORS (include production Vercel URL)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_EXTRACT_UPLOAD_MB=55

# Feature flags and cost controls
AI_PROVIDER=mock
# Run video metadata / clip export / document extract / mock video jobs via next/server `after()` so actions return quickly
ASYNC_VIDEO_JOBS=true
ASYNC_CLIP_EXPORT=true
ASYNC_DOCUMENT_EXTRACT=true
ASYNC_MOCK_VIDEO_JOBS=true
ASYNC_AI_GENERATION=true
ENABLE_VIDEO_RENDERING=false
ENABLE_AVATAR_GENERATION=false
MAX_VIDEO_UPLOAD_MB=500
MAX_DOCUMENT_UPLOAD_MB=50
MAX_PROJECTS_PER_USER=10
MAX_FILES_PER_PROJECT=25

# Optional browser mirrors for client-side validation (defaults match server)
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=500
NEXT_PUBLIC_MAX_DOCUMENT_UPLOAD_MB=50
NEXT_PUBLIC_MAX_FILES_PER_PROJECT=25
